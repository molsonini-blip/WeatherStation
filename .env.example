# --- required ---------------------------------------------------------------
TEMPEST_TOKEN=paste-your-tempest-personal-access-token
TEMPEST_STATION_ID=217588
TZ=America/Chicago

# --- IFTTT (optional) -------------------------------------------------------
# ifttt.com/maker_webhooks -> Documentation shows your key
IFTTT_KEY=
IFTTT_EVENT_PREFIX=tempest_

# --- server -----------------------------------------------------------------
HTTP_PORT=8088
DB_PATH=/data/tempest.db
DAILY_SUMMARY_TIME=07:00
# NWS asks for a contact in the User-Agent; put your own if you like
NWS_USER_AGENT=tempest-monitor/1.0 (home weather station)

# --- storm mode: any of these = storm (max rate until it clears) -------------
STORM_LIGHTNING_MI=15
STORM_GUST_MPH=30
STORM_LOOKBACK_MIN=15
STORM_CLEAR_MIN=45

# --- watch mode ("right before"): any of these = go live --------------------
WATCH_LIGHTNING_MI=40
WATCH_PRESSURE_DROP_MB=2.0
WATCH_POP=60
WATCH_LOOKBACK_MIN=30
WATCH_CLEAR_MIN=30

# --- alert thresholds -------------------------------------------------------
ALERT_LIGHTNING_MI=8
ALERT_GUST_MPH=40
ALERT_RAIN_INHR=1.0
ALERT_COOLDOWN_MIN=30

# --- polling cadence --------------------------------------------------------
NORMAL_FORECAST_HOURS=3
NORMAL_NWS_MIN=5
LIVE_FORECAST_MIN=15
LIVE_NWS_MIN=2

# --- hail ---------------------------------------------------------------------
ALERT_HAIL_MIN_IN=0
HAIL_COOLDOWN_MIN=15
